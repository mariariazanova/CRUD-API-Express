{
  "name": "crud-api",
  "version": "1.0.0",
  "description": "A simple CRUD API using Node.js and TypeScript",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsc",
    "start": "ts-node-dev ./src/index.ts",
    "start:prod": "npm run build && node dist/index.js",
    "docker": "docker-compose up --build",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,js,json,css,scss,html}\" \"src/*.ts\"",
    "format:check": "prettier --check \"src/**/*.{ts,js,json,css,scss,html}\" \"src/*.ts\""
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "sqlite": "^5.1.1",
    "sqlite3": "^5.1.7",
    "uuid": "^11.0.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.19.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.7.7",
    "@types/sqlite3": "^3.1.11",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.22.0",
    "dotenv-webpack": "^8.1.0",
    "eslint": "^9.19.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.3",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "ts-loader": "^9.5.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.22.0",
    "webpack": "^5.97.1",
    "webpack-cli": "^5.1.4"
  },
  "keywords": [],
  "author": "Maria Riazanova",
  "license": "ISC"
}
